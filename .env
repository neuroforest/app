# Application
APP_NAME=NeuroForest
APP_URL=https://github.com/neuroforest
APP_VERSION=1.7.0

HOST=127.0.0.1
PORT=8080
TEST_PORT=8069

LOGGING=WARNING
LOGGING_FORMAT="%(levelname)s %(name)s: %(message)s"

# Paths
ARCHIVE=archive
ASSETS=assets
BUILD=build
DESIGN=design
DESKTOP=desktop
LOGS=logs
NENV=nenv
NEURO=neuro
PKG=pkg
STORAGE=storage
TW5=build/tw5

# NeuroDesktop
DESKTOP_NAME=NeuroDesktop
TW5_EDITION=neuro-neo4j
NWJS_URL=https://dl.node-webkit.org
NWJS_VERSION=0.91.0
DESKTOP_ARGS=

# NeuroBase
BASE_NAME=neurobase
NBASE_IMAGE=nbase
NBASE_VERSION=1.0

NEO4J_VERSION=5.26.7
NEO4J_PORT_HTTP=7474
NEO4J_PORT_BOLT=7687
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Knowledge integration
PLUGINS=assets/ontology
ONTOLOGY_OBJECTS=["OntologyNode","OntologyRelationship","OntologyProperty","OntologyMetadata"]
OBJECT_SETS=[]
ROLE_DICT={}

# API keys
NCBI_API_KEY=