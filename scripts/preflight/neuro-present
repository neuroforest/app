#!/usr/bin/env bash
# The host's neuro must be at least the one this tree was written against
# (PLAN-2026-322). The tasks import neuro from the host venv; the floor is the
# submodule's own VERSION at this commit — the neuro the superproject pins. This
# manifest does not ship neuro: `deploy neuro` does (PLAN-2026-321); this refuses
# until it has.
#
# Per target: rodus sets RODUS_TARGET_HOST and RODUS_TARGET_VENV. No place is
# named here — this repo is public, the places live in deploy.local.toml.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
HOST="${RODUS_TARGET_HOST:?RODUS_TARGET_HOST unset — run through rodus, per target}"
VENV="${RODUS_TARGET_VENV:?RODUS_TARGET_VENV unset — the target declares no venv}"

FLOOR="$(tr -d '[:space:]' < "$ROOT/neuro/VERSION")"
[[ -n "$FLOOR" ]] || { echo "  ✘ neuro/VERSION is empty — is the submodule checked out?" >&2; exit 1; }
HAVE="$(ssh "$HOST" "$VENV/bin/python -c \"import importlib.metadata as m; print(m.version('neuro'))\"")" \
    || { echo "  ✘ cannot read the neuro version in $VENV on $HOST — not installed? \`deploy neuro\` ships it" >&2; exit 1; }
if [[ "$(printf '%s\n%s\n' "$FLOOR" "$HAVE" | sort -V | head -1)" != "$FLOOR" ]]; then
    echo "  ✘ $HOST has neuro $HAVE — this tree pins neuro $FLOOR; \`deploy neuro --bump …\` first" >&2
    exit 1
fi
echo "    neuro $HAVE >= $FLOOR (the submodule's VERSION)"
