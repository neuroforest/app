#!/usr/bin/env bash
# The app's suite and ruff, once, before the bump (PLAN-2026-369): a red suite
# must never leave a RELEASE commit behind. `targets = []` in deploy.toml, so
# rodis runs this before the version moves and before any target is touched.
#
# Through `nde`, as the testing skill asks — the invoke tasks own ENV=TESTING and
# the nenv, so the wrapper is the one entry point and nothing here picks an
# interpreter. No host is named: this repo is public.
set -euo pipefail
command -v nde >/dev/null 2>&1 \
    || { echo "  ✘ nde is not on PATH — the suite runs through the invoke wrapper" >&2; exit 1; }
nde app.test
nde test.ruff
echo "    app suite and ruff green"
